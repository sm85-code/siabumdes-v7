# Neon PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://user:password@host/database?sslmode=require

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Browser origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:3000

# Google Drive OAuth (required only for Drive-backed proof files)
GDRIVE_OAUTH_CLIENT_DATA={"web":{"client_id":"...","client_secret":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","redirect_uris":["https://api.example.com/api/gdrive/oauth-callback"]}}
GDRIVE_FOLDER_ID=replace-with-drive-folder-id
GDRIVE_REDIRECT_URI=https://api.example.com/api/gdrive/oauth-callback
# Optional legacy callback name used by older OAuth state records
GDRIVE_OAUTH_REDIRECT=https://api.example.com/api/gdrive/oauth-callback
